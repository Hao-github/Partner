# 复制本文件为 .env，在本机填写真实密钥。不要将 .env 提交到 Git。
# 由 python-dotenv 读取；系统环境变量优先于 .env，支持引号与 ${变量} 展开。
BUTLER_PROVIDER=deepseek
BUTLER_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# 切换 OpenAI：BUTLER_PROVIDER=openai，并修改 BUTLER_MODEL 为账户可用、
# 支持 Chat Completions + function calling 的模型，同时填写 OPENAI_API_KEY。
OPENAI_API_KEY=
# 不设置时按 provider 自动选择根地址。切换 provider 时也需同步自定义地址。
# BUTLER_BASE_URL=https://api.deepseek.com

BUTLER_DB_PATH=data/sessions.sqlite3
BUTLER_TIMEOUT_SECONDS=30
BUTLER_MAX_RETRIES=2
BUTLER_HISTORY_TURNS=20
BUTLER_MAX_OUTPUT_TOKENS=2048
BUTLER_MAX_TOOL_ROUNDS=3

# QQ 官方机器人私聊：在 q.qq.com 创建机器人后填写。
QQ_APP_ID=
QQ_APP_SECRET=
# 先运行 python first.py --channel qq --qq-discover 获取自己的 OpenID。
# 这里填写 OpenID，不是普通 QQ 号；多个用户用英文逗号分隔。
QQ_ALLOWED_USERS=
QQ_MIN_INTERVAL_SECONDS=3
# 本项目对单条回复的本地字符限制，超出时明确提示截断。
QQ_REPLY_MAX_CHARS=1800
# 通常无需修改；如平台要求其他环境，使用控制台与当前官方文档指定的地址。
# QQ_API_BASE_URL=https://api.bot.qq.com
